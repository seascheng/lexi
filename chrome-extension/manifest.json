{
  "manifest_version": 3,
  "name": "Lexi",
  "version": "1.0.0",
  "description": "Send selected text in Chrome to the Lexi desktop app.",
  "permissions": ["activeTab"],
  "host_permissions": ["http://127.0.0.1:47291/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
