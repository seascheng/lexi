{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lexi",
  "version": "0.1.0",
  "identifier": "com.lexi.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "Lexi",
        "url": "index.html",
        "width": 1180,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640,
        "transparent": true,
        "center": true,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "macOS": {
      "signingIdentity": "Apple Development: chengweipeng123@163.com (D8YJ3P5B53)"
    },
    "resources": [
      "native/LexiSelectionHelper.app"
    ],
    "icon": [
      "icons/icon.png"
    ]
  }
}